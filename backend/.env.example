# backend/.env.example
# Copy this file to backend/.env and fill in real values before running Flask.
# Flask must be run from the backend/ directory so python-dotenv finds this file.

# OpenAI API key (required)
OPENAI_API_KEY=sk-...

# Flask session signing key (required) — generate with:
#   python -c "import secrets; print(secrets.token_hex(24))"
FLASK_SECRET_KEY=change-this-secret

# DEPRECATED (Phase 2 / D-05): legacy shared-password auth replaced by email OTP.
# This var is no longer read by the backend — safe to remove from your local .env.
# APP_LOGIN_PASSWORD=change-this-password

# ── Email OTP authentication (Phase 2) ─────────────────────────────────────
# Resend API key (required — create at https://resend.com/api-keys)
RESEND_API_KEY=re_...

# Sender identity for OTP emails. In dev, 'onboarding@resend.dev' only delivers
# to the Resend account holder's inbox; verify a domain at https://resend.com/domains
# to deliver to arbitrary recipients.
RESEND_FROM_EMAIL=Tampa Code AI <onboarding@resend.dev>

# CORS allowed origin for the Vite dev server (Phase 2 / D-04).
# Production origin is added in Phase 4 when the Render URL is known.
FRONTEND_ORIGIN=http://localhost:5173

# OTP code TTL in seconds (optional — default 600 = 10 minutes per AUTH-04)
# OTP_TTL_SEC=600

# Flask env flag — set to "production" on Render so session cookie becomes Secure
# FLASK_ENV=production

# Model overrides (optional — defaults shown)
# SEARCH_MODEL=gpt-4o-mini
# ADDRESS_MODEL=gpt-4o
# EMBED_MODEL=text-embedding-3-small

# Retrieval tuning (optional — defaults shown)
# SEARCH_K=10
# MULTI_QUERY_ENABLED=true
# MULTI_QUERY_N=3
# ADDRESS_SEARCH_MAX_DISTANCE=2.5

# GIS cache TTL in seconds (optional — default 3600 = 1 hour)
# GIS_CACHE_TTL_SEC=3600

# Audit logging (optional — default true)
# AUDIT_ENABLED=true

# Input length guards (optional — defaults shown)
# MAX_QUESTION_LEN=1000
# MAX_DESC_LEN=600
# MAX_ADDRESS_LEN=200

# Filesystem paths (optional — defaults are relative to backend/ CWD)
# INDEX_PATH=tampa_code.index
# CHUNKS_PATH=chunks.json
# DB_PATH=permitiq.db
